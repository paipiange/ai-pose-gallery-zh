FROM nginx:alpine

# 移除默认的静态页面与配置
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# 复制自定义 Nginx 优化配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 复制前端主应用与静态素材目录
WORKDIR /usr/share/nginx/html
COPY index.html ./
COPY data/ ./data/
COPY img/ ./img/
COPY presets/ ./presets/
COPY thumbs/ ./thumbs/
COPY skills/ ./skills/
COPY robots.txt ./
COPY _headers ./
COPY LICENSE ./

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
