# ==============================================================================
# 拍片哥 AI 姿势库与工坊 (AI Pose Gallery & Studio) - Docker 环境变量模板
# 使用方式：复制当前文件为 .env 文件：cp .env.example .env
# ==============================================================================

# ----------------- 服务端口配置 -----------------
# 前端访问端口（浏览器访问 http://localhost:8080）
FRONTEND_PORT=8080

# 后端 API 接口端口（若需宿主机直接调用接口 http://localhost:8000）
BACKEND_PORT=8000

# ----------------- 大模型 API Key 配置 -----------------
# 说明：以下配置按需填写，用哪个模型就配置哪个对应的 Key。
# 也完全可以在启动后直接在网页端【设置中心】临时配置并保存在浏览器本地，更加安全。

# 1. Google Gemini（强烈推荐·写实逼真且支持 100% 姿势保留）
# 获取地址：https://aistudio.google.com
GEMINI_API_KEY=

# 2. 豆包 Seedream（火山方舟·国内极速直连）
# 获取地址：https://console.volcengine.com/ark
ARK_API_KEY=

# 3. OpenAI GPT-Image-2（OpenAI 标准协议兼容）
# 获取地址：https://platform.openai.com
OPENAI_API_KEY=

# 4. 阿里通义万相 / DashScope（可选）
DASHSCOPE_API_KEY=

# ----------------- 本地 ComfyUI 离线配置 -----------------
# 若宿主机正在运行 ComfyUI（如 Qwen-Image-Edit-2511 或 MiniMax H3 显卡工作流）
# 容器内通过 host.docker.internal 即可直接访问宿主机显卡服务，无需云端 Key
COMFYUI_HOST=host.docker.internal
COMFYUI_PORT=8188
